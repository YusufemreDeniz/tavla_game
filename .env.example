# Bu dosyayi .env olarak kopyalayin ve GERCEK degerleri yazin.
# .env dosyasi asla repository'ye commit edilmez.

# SQL Server SA parolasi: en az 8 karakter, buyuk/kucuk harf, rakam ve sembol icermeli.
MSSQL_SA_PASSWORD=DEGISTIRIN_guclu_Parola_1!

# JWT imzalama anahtari: en az 64 karakter rastgele deger uretin.
# Ornek uretim: openssl rand -base64 64
JWT_SIGNING_KEY=DEGISTIRIN_en_az_64_karakter_rastgele_uretilmis_gizli_anahtar_kullanin
